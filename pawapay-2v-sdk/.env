# ============================================================================
# PAWAPAY SDK CONFIGURATION
# ============================================================================
# 
# This file contains all configuration options for the PawaPay SDK.
# Copy this to your project and update the values as needed.
# 
# IMPORTANT: Never commit this file with real credentials to version control!
# ============================================================================

# ============================================================================
# API CREDENTIALS
# ============================================================================
# Get these from your PawaPay dashboard: https://dashboard.pawapay.io

# API Token (required)
PAWAPAY_API_TOKEN=your_pawapay_api_token_here

# Webhook Secret (required for webhook verification)
PAWAPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Environment: sandbox|production
PAWAPAY_ENVIRONMENT=sandbox

# API Base URLs
PAWAPAY_SANDBOX_URL=https://api.sandbox.pawapay.io
PAWAPAY_PRODUCTION_URL=https://api.pawapay.io

# ============================================================================
# FEE CONFIGURATION
# ============================================================================
# Configure how fees are handled in your application

# Fee Override Percentage (0.00 to 1.00)
# Set to 0 to disable all fees for customers
# Set to null to use PawaPay's standard fee structure
# Examples: 0.02 = 2%, 0.015 = 1.5%, 0 = no fees
PAWAPAY_FEE_OVERRIDE_PERCENTAGE=

# Apply fees to transaction amount
# true = add fees to product price before sending to PawaPay
# false = fees handled separately
PAWAPAY_APPLY_FEES_TO_AMOUNT=true

# Fee calculation precision (decimal places)
PAWAPAY_FEE_PRECISION=2

# Minimum fee amount (in base currency units)
PAWAPAY_MINIMUM_FEE=

# Maximum fee amount (in base currency units) 
PAWAPAY_MAXIMUM_FEE=

# Default country for fee calculations (2-letter code)
PAWAPAY_DEFAULT_COUNTRY=ZM

# Default operator for fee calculations
PAWAPAY_DEFAULT_OPERATOR=MTN_MOMO_ZMB

# ============================================================================
# ZAMBIA-SPECIFIC FEE SETTINGS  
# ============================================================================

# Enable/disable fee charging (true/false)
PAWAPAY_ZAMBIA_ENABLE_FEES=true

# Airtel Money Zambia fees
PAWAPAY_AIRTEL_ZMB_BASE_FEE=2.00
PAWAPAY_AIRTEL_ZMB_PERCENTAGE=0.005
PAWAPAY_AIRTEL_ZMB_MIN_FEE=2.00
PAWAPAY_AIRTEL_ZMB_MAX_FEE=50.00

# MTN Mobile Money Zambia fees
PAWAPAY_MTN_ZMB_PERCENTAGE=0.01
PAWAPAY_MTN_ZMB_MIN_FEE=1.00
PAWAPAY_MTN_ZMB_MAX_FEE=100.00

# Zamtel Kwacha fees (tiered structure - see config/zambia_config.php)
PAWAPAY_ZAMTEL_ZMB_ENABLE_TIERS=true

# Customer fee responsibility (true = customer pays, false = merchant absorbs)
PAWAPAY_CUSTOMER_PAYS_FEES=true


# ============================================================================
# WEBHOOK CONFIGURATION
# ============================================================================

# Webhook URL (must be HTTPS in production)
PAWAPAY_WEBHOOK_URL=https://yourdomain.com/pawapay/webhook

# Webhook retry attempts
PAWAPAY_WEBHOOK_RETRY_ATTEMPTS=3

# Webhook timeout (seconds)
PAWAPAY_WEBHOOK_TIMEOUT=30

# ============================================================================
# REDIRECT CONFIGURATION
# ============================================================================

# Success redirect URL (use {transactionId} placeholder)
PAWAPAY_SUCCESS_URL=https://yourdomain.com/payment/success/{transactionId}

# Failure redirect URL
PAWAPAY_FAILURE_URL=https://yourdomain.com/payment/failed

# Cancel redirect URL
PAWAPAY_CANCEL_URL=https://yourdomain.com/payment/cancelled

# ============================================================================
# RECONCILIATION SETTINGS
# ============================================================================

# Enable automatic reconciliation
PAWAPAY_RECONCILIATION_ENABLED=true

# Reconciliation interval (minutes)
# How long to wait before attempting reconciliation
PAWAPAY_RECONCILIATION_INTERVAL=15

# Maximum reconciliation attempts
PAWAPAY_RECONCILIATION_MAX_ATTEMPTS=5

# Reconciliation batch size
PAWAPAY_RECONCILIATION_BATCH_SIZE=100

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: debug|info|warning|error
PAWAPAY_LOG_LEVEL=info

# Log file path (relative to project root)
PAWAPAY_LOG_FILE=logs/pawapay.log

# Enable debug mode
PAWAPAY_DEBUG_MODE=false

# Log API requests and responses (be careful with sensitive data)
PAWAPAY_LOG_API_REQUESTS=false

# ============================================================================
# TIMEOUT SETTINGS
# ============================================================================

# API request timeout (seconds)
PAWAPAY_REQUEST_TIMEOUT=30

# Connection timeout (seconds)
PAWAPAY_CONNECTION_TIMEOUT=10

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================

# Enable fee calculation caching
PAWAPAY_CACHE_FEES=true

# Fee cache duration (seconds)
PAWAPAY_CACHE_DURATION=3600

# Cache driver: file|redis|memcached|array
PAWAPAY_CACHE_DRIVER=file

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Enable rate limiting
PAWAPAY_RATE_LIMITING=true

# Rate limit: requests per minute
PAWAPAY_RATE_LIMIT_RPM=60

# IP whitelist for webhook endpoints (comma-separated)
PAWAPAY_WEBHOOK_IP_WHITELIST=

# ============================================================================
# DATABASE CONFIGURATION (for Modesy integration)
# ============================================================================

# Database connection details
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=modesy_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4

# Table prefix (if any)
DB_TABLE_PREFIX=

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================

# Enable test mode (uses sandbox automatically)
PAWAPAY_TEST_MODE=true

# Test phone numbers (comma-separated)
PAWAPAY_TEST_PHONES=+256700000001,+256700000002,+256700000003

# Test amounts for automated testing
PAWAPAY_TEST_AMOUNTS=100,500,1000,5000

# Test currencies
PAWAPAY_TEST_CURRENCIES=USD,KES,UGX,TZS,ZMW

# Skip SSL verification in tests (sandbox only)
PAWAPAY_TEST_SKIP_SSL=true

# ============================================================================
# MODESY MARKETPLACE INTEGRATION
# ============================================================================

# Enable Modesy integration features
PAWAPAY_MODESY_INTEGRATION=true

# Modesy base URL
MODESY_BASE_URL=https://your-modesy-site.com

# Default commission rate for marketplace (percentage)
PAWAPAY_DEFAULT_COMMISSION_RATE=0.05

# Multi-vendor support
PAWAPAY_MULTI_VENDOR_ENABLED=true

# Commission calculation method: per_product|per_vendor|flat_rate
PAWAPAY_COMMISSION_METHOD=per_vendor

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# User agent for API requests
PAWAPAY_USER_AGENT="PawaPay-PHP-SDK/2.0"

# Enable request signing
PAWAPAY_ENABLE_REQUEST_SIGNING=true

# Timezone for date operations
PAWAPAY_TIMEZONE=UTC

# Default currency
PAWAPAY_DEFAULT_CURRENCY=USD

# Currency formatting
PAWAPAY_CURRENCY_DECIMALS=2

# Enable automatic retries for failed requests
PAWAPAY_AUTO_RETRY=true

# Number of retry attempts
PAWAPAY_RETRY_ATTEMPTS=3

# Retry delay (seconds)
PAWAPAY_RETRY_DELAY=1

# ============================================================================
# NOTIFICATION SETTINGS
# ============================================================================

# Email notifications for failed payments
PAWAPAY_EMAIL_NOTIFICATIONS=false

# Notification email address
PAWAPAY_NOTIFICATION_EMAIL=admin@yourdomain.com

# Slack webhook for notifications
PAWAPAY_SLACK_WEBHOOK=

# SMS notifications (if integrated)
PAWAPAY_SMS_NOTIFICATIONS=false