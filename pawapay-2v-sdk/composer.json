{
    "name": "pawapay/pawapay-2v-sdk",
    "description": "Official PawaPay PHP SDK v2 with comprehensive marketplace integration, fee calculations, and real API testing support",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "pawapay",
        "mobile-money",
        "payments",
        "africa",
        "mtn",
        "airtel",
        "mpesa",
        "orange-money",
        "marketplace",
        "modesy"
    ],
    "homepage": "https://www.pawapay.io",
    "support": {
        "email": "support@pawapay.co.uk",
        "docs": "https://docs.pawapay.co.uk",
        "issues": "https://github.com/pawapay/pawapay-2v-sdk/issues",
        "source": "https://github.com/pawapay/pawapay-2v-sdk"
    },
    "authors": [
        {
            "name": "PawaPay Development Team",
            "email": "dev@pawapay.co.uk",
            "homepage": "https://www.pawapay.io",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.0",
        "monolog/monolog": "^2.0|^3.0",
        "vlucas/phpdotenv": "^5.0",
        "ramsey/uuid": "^4.0",
        "nesbot/carbon": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0",
        "mockery/mockery": "^1.4",
        "php-coveralls/php-coveralls": "^2.0",
        "squizlabs/php_codesniffer": "^3.0",
        "phpstan/phpstan": "^1.0",
        "pestphp/pest": "^1.0|^2.0",
        "fakerphp/faker": "^1.20",
        "phpunit/php-code-coverage": "^9.0|^10.0"
    },
    "suggest": {
        "doctrine/dbal": "For advanced database operations in marketplace integrations",
        "symfony/cache": "For caching API responses and fee calculations",
        "predis/predis": "For Redis-based session and cache storage"
    },
    "autoload": {
        "psr-4": {
            "PawaPay\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PawaPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "pest": "pest",
        "cs-check": "phpcs --standard=PSR12 src/ tests/",
        "cs-fix": "phpcbf --standard=PSR12 src/ tests/",
        "stan": "phpstan analyse src/ --level=8",
        "sdk-test": "php tests/RealApiTest.php",
        "fee-calculator-test": "php tests/FeeCalculatorTest.php",
        "integration-test": "php tests/Integration/ModesyIntegrationTest.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    }
}